server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/rentdetective?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: ""
    driver-class-name: com.mysql.cj.jdbc.Driver
  threads:
    virtual:
      enabled: true
  data:
    redis:
      host: localhost
      port: 6379
      password: ""
      database: 0

mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

rentdetective:
  llm:
    ollama:
      base-url: http://localhost:11434
      model: qwen3:1.7b
      embedding-model: bge-m3
    openai-compatible:
      base-url: https://api.siliconflow.cn/v1
      api-key: ""
      model: deepseek-ai/DeepSeek-V4-Flash
      embedding-model: BAAI/bge-large-zh-v1.5
      temperature: 0.0